# ============================================================
#  .gitignore — RL-Guided Multi-Hop Legal QA System
# ============================================================

# ── Python cache ─────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.pycache

# ── Virtual environments ──────────────────────────────────────
venv/
venv1/
.venv/
.env/

# ── Environment variables (secrets) ──────────────────────────
.env

# ── Python model / binary weights ────────────────────────────
*.pkl
*.bin
*.h5
*.pt
*.onnx
*.safetensors

# ── Trained models (large) ───────────────────────────────────
decomp_model/
classifier_model/
rl_model/*.pt
results/

# ── ChromaDB vector store ─────────────────────────────────────
chroma_db/
db/

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── Data files ────────────────────────────────────────────────
*.csv
*.xlsx
*.json.bak

# ── OS files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDEs ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Python build artifacts ────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
site/

# ── Node.js / React Frontend ──────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env.local
frontend/.env.production

# ── Temporary / scratch ───────────────────────────────────────
tmp/
temp/
rmdir
